# Maven のビルド成果物
target/
# IntelliJ IDEA の設定ファイル
.idea/
# Eclipse の設定ファイル
.classpath
.project
.settings/
# VS Code の設定ファイル
.vscode/
# OS が生成するファイル
.DS_Store
Thumbs.db
# ログファイル
*.log
# 環境変数ファイル（DB パスワード等の秘密情報を含むためコミットしない。雛形は .env.example）
.env
.env.local
# DB バックアップ（支出データを含むためコミットしない。README の運用手順参照）。
# 先頭の / でリポジトリ直下の backup/ だけに限定する（どの階層の backup/ も
# 無視してしまうと、将来 docs/backup/ 等を追加した人が気づかず取りこぼす）
/backup/
# 誤って別の場所に置いた dump も取りこぼさないための保険（リポジトリ全体に効く）。
# JVM ヒープダンプやテスト用フィクスチャなど、意図して追加したい .dump がある場合は
# git add -f で個別に追加すること（気づかず無視されるのを防ぐためここに明記する）
*.dump
# backup.yml が生成する GPG 暗号化済みダンプ（暗号化済みでも本番データ由来のためコミットしない）
*.dump.gpg
