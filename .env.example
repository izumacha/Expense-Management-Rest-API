# expense-tracker の環境変数サンプル（キー名のみ。実際の値はコミットしないこと）
# このファイルを .env にコピーし、各値を設定してから docker compose を起動する。

# データベースのユーザー名（任意・未設定ならローカル既定値）
SPRING_DATASOURCE_USERNAME=
# データベースのパスワード（必須・未設定だとアプリの起動に失敗する＝fail-closed）
SPRING_DATASOURCE_PASSWORD=
# アクセストークン（JWT）の HS256 署名用共有シークレット（必須・32 バイト以上。未設定/短すぎだと起動失敗＝fail-closed）
JWT_SECRET=
# トークン発行（POST /api/auth/token）で照合する API ユーザーのユーザー名（必須・未設定だと起動失敗）
API_USER_NAME=
# API ユーザーのパスワードの bcrypt ハッシュ（必須。平文は設定しない。未設定/平文だと起動失敗）
# 例: htpasswd -bnBC 12 "" "パスワード" | tr -d ':\n' で生成した $2a$... で始まる文字列
API_USER_PASSWORD_HASH=
# ブラウザからの呼び出しを許可するオリジンのカンマ区切り（任意・未設定なら全オリジン拒否。* は指定不可）
CORS_ALLOWED_ORIGINS=
# Hibernate のスキーマ反映方針（任意・アプリの既定は validate＝DDL を発行せず不一致なら起動失敗）。
# docker compose は開発用スタックとして update を明示指定するため、通常この値の設定は不要。
# 本番で validate 以外（update / create 等）を指定すると起動時に本番スキーマが自動変更される。
SPRING_JPA_HIBERNATE_DDL_AUTO=
